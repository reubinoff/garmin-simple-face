<settings xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">
    <setting propertyKey="@Properties.TimeSize" title="@Strings.TimeSizeTitle">
        <settingConfig type="list">
            <listEntry value="0">@Strings.SizeSmall</listEntry>
            <listEntry value="1">@Strings.SizeMedium</listEntry>
            <listEntry value="2">@Strings.SizeLarge</listEntry>
        </settingConfig>
    </setting>
    <setting propertyKey="@Properties.HourColor" title="@Strings.HourColorTitle">
        <settingConfig type="list">
            <listEntry value="0xFFFFFF">@Strings.ColorWhite</listEntry>
            <listEntry value="0x00D4FF">@Strings.ColorCyan</listEntry>
            <listEntry value="0x30E060">@Strings.ColorGreen</listEntry>
            <listEntry value="0xFFD60A">@Strings.ColorYellow</listEntry>
            <listEntry value="0xFF9500">@Strings.ColorOrange</listEntry>
            <listEntry value="0xFF453A">@Strings.ColorRed</listEntry>
            <listEntry value="0xFF4FA0">@Strings.ColorPink</listEntry>
            <listEntry value="0xB388FF">@Strings.ColorPurple</listEntry>
        </settingConfig>
    </setting>
    <setting propertyKey="@Properties.MinuteColor" title="@Strings.MinuteColorTitle">
        <settingConfig type="list">
            <listEntry value="0xFFFFFF">@Strings.ColorWhite</listEntry>
            <listEntry value="0x00D4FF">@Strings.ColorCyan</listEntry>
            <listEntry value="0x30E060">@Strings.ColorGreen</listEntry>
            <listEntry value="0xFFD60A">@Strings.ColorYellow</listEntry>
            <listEntry value="0xFF9500">@Strings.ColorOrange</listEntry>
            <listEntry value="0xFF453A">@Strings.ColorRed</listEntry>
            <listEntry value="0xFF4FA0">@Strings.ColorPink</listEntry>
            <listEntry value="0xB388FF">@Strings.ColorPurple</listEntry>
        </settingConfig>
    </setting>
</settings>
