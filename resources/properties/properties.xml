<properties xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">
    <!-- 0 = Small, 1 = Medium, 2 = Large, 3 = X-Large, 4 = XX-Large. Must match settings.xml and source/NoirSettings.mc. -->
    <property id="TimeSize" type="number">1</property>
    <!-- Colours as 0xRRGGBB. Must be one of the list entries in settings.xml / NoirSettings.colorValues(). -->
    <property id="HourColor" type="number">0xFFFFFF</property>
    <property id="MinuteColor" type="number">0xFFFFFF</property>
    <!-- Data field slots (DECISIONS.md D-39): a NoirFields id, 0 = None. Must match settings.xml and
         source/NoirFields.mc. A field the watch does not support leaves its slot empty. -->
    <property id="FieldLeft" type="number">1</property>
    <property id="FieldRight" type="number">2</property>
    <property id="FieldBottom" type="number">0</property>
</properties>
