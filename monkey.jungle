project.manifest = manifest.xml
project.typecheck = strict

# Multi-device support, DECISIONS.md D-36. Jungle syntax: Build Configuration / Jungle Reference
# (https://developer.garmin.com/connect-iq/core-topics/build-configuration/).

# Annotations: (:ciq4) code uses API 4+/5+ symbols (Graphics.getVectorFont 4.2.1, System.getDisplayMode 5.0.0);
# (:ciq3) is its fallback for API 3.x devices, where the compiler rejects those symbols even behind `has`.
# (:bodybattery) uses SensorHistory.getBodyBatteryHistory (3.3.0); (:nobodybattery) is the fallback for API 3.1/3.2.
base.excludeAnnotations = ciq3;nobodybattery
fr245.excludeAnnotations = ciq4;nobodybattery
fr245m.excludeAnnotations = ciq4;nobodybattery
fr745.excludeAnnotations = ciq4;nobodybattery
fr945.excludeAnnotations = ciq4;nobodybattery
fr945lte.excludeAnnotations = ciq4;nobodybattery
fr55.excludeAnnotations = ciq4;nobodybattery
fr645.excludeAnnotations = ciq4;bodybattery
fr645m.excludeAnnotations = ciq4;bodybattery
fr935.excludeAnnotations = ciq4;bodybattery

# Launcher icon in each device's own size (compiler.json launcherIcon); resources/ has the 65 x 65 one.
fenix843mm.resourcePath = $(fenix843mm.resourcePath);launcher-icons/60
fenix943mm.resourcePath = $(fenix943mm.resourcePath);launcher-icons/60
